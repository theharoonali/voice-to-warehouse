{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"../../packages/contracts/dist/**/*.js\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test src/routes/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.77",
    "@repo/contracts": "*",
    "ai": "^7.0.134",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.0",
    "tsx": "^4.23.15"
  }
}
